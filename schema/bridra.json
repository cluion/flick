{
  "schemaVersion": 1,
  "protocolVersion": 4,
  "methods": [
    {
      "name": "system.health",
      "clientName": "health",
      "result": {
        "goType": "HealthResponse",
        "dartType": "HealthInfo",
        "fields": [
          {"name": "status", "type": "string"},
          {"name": "frameworkVersion", "type": "string"},
          {"name": "protocolVersion", "type": "integer"},
          {"name": "runtime", "type": "string"},
          {"name": "architecture", "type": "string"}
        ]
      }
    },
    {
      "name": "files.scan",
      "clientName": "scanDirectories",
      "params": {
        "goType": "ScanDirectoriesRequest",
        "dartType": "ScanDirectoriesRequest",
        "fields": [
          {"name": "directories", "type": "string", "array": true},
          {"name": "recursive", "type": "boolean"},
          {"name": "patterns", "type": "string", "array": true},
          {"name": "includeHidden", "type": "boolean"}
        ]
      },
      "result": {
        "goType": "ScanDirectoriesResponse",
        "dartType": "DirectoryScanResult",
        "fields": [
          {"name": "paths", "type": "string", "array": true},
          {"name": "skippedCount", "type": "integer"}
        ]
      }
    },
    {
      "name": "rename.preview",
      "clientName": "previewRename",
      "params": {
        "goType": "PreviewRenameRequest",
        "dartType": "PreviewRenameRequest",
        "fields": [
          {"name": "paths", "type": "string", "array": true},
          {"name": "recipe", "type": "string", "minLength": 2},
          {"name": "collisionStrategy", "type": "string"},
          {"name": "excludedPaths", "type": "string", "array": true},
          {"name": "overridePaths", "type": "string", "array": true},
          {"name": "overrideNames", "type": "string", "array": true}
        ]
      },
      "result": {
        "goType": "RenamePlanResponse",
        "dartType": "RenamePlan",
        "fields": [
          {"name": "planId", "type": "string"},
          {"name": "sourcePaths", "type": "string", "array": true},
          {"name": "originalNames", "type": "string", "array": true},
          {"name": "proposedNames", "type": "string", "array": true},
          {"name": "targetPaths", "type": "string", "array": true},
          {"name": "statuses", "type": "string", "array": true},
          {"name": "messages", "type": "string", "array": true},
          {"name": "included", "type": "boolean", "array": true},
          {"name": "overridden", "type": "boolean", "array": true},
          {"name": "collisionResolved", "type": "boolean", "array": true},
          {"name": "sizes", "type": "integer", "array": true},
          {"name": "modifiedAt", "type": "integer", "array": true},
          {"name": "renameableCount", "type": "integer"},
          {"name": "unchangedCount", "type": "integer"},
          {"name": "errorCount", "type": "integer"},
          {"name": "excludedCount", "type": "integer"}
        ]
      }
    },
    {
      "name": "rename.apply",
      "clientName": "applyRename",
      "params": {
        "goType": "ApplyRenameRequest",
        "dartType": "ApplyRenameRequest",
        "fields": [
          {"name": "planId", "type": "string", "minLength": 1}
        ]
      },
      "result": {
        "goType": "ApplyRenameResponse",
        "dartType": "ApplyRenameResult",
        "fields": [
          {"name": "batchId", "type": "string"},
          {"name": "changedCount", "type": "integer"},
          {"name": "message", "type": "string"}
        ]
      }
    },
    {
      "name": "rename.undo",
      "clientName": "undoRename",
      "params": {
        "goType": "UndoRenameRequest",
        "dartType": "UndoRenameRequest",
        "fields": [
          {"name": "batchId", "type": "string", "minLength": 1}
        ]
      },
      "result": {
        "goType": "UndoRenameResponse",
        "dartType": "UndoRenameResult",
        "fields": [
          {"name": "batchId", "type": "string"},
          {"name": "changedCount", "type": "integer"},
          {"name": "message", "type": "string"}
        ]
      }
    },
    {
      "name": "rename.history",
      "clientName": "renameHistory",
      "result": {
        "goType": "RenameHistoryResponse",
        "dartType": "RenameHistory",
        "fields": [
          {"name": "batchIds", "type": "string", "array": true},
          {"name": "timestamps", "type": "string", "format": "date-time", "array": true},
          {"name": "changedCounts", "type": "integer", "array": true},
          {"name": "undoable", "type": "boolean", "array": true}
        ]
      }
    }
  ]
}
